{
  "name": "intellectro",
  "version": "0.0.1-alpha",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "intellectro",
      "version": "0.0.1-alpha",
      "workspaces": [
        "packages/*",
        "agents/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "agents/claim-agent": {
      "name": "@intellectro/claim-agent",
      "version": "0.0.1-alpha"
    },
    "agents/community-agent": {
      "name": "@intellectro/community-agent",
      "version": "0.0.1-alpha"
    },
    "node_modules/@intellectro/claim-agent": {
      "resolved": "agents/claim-agent",
      "link": true
    },
    "node_modules/@intellectro/community-agent": {
      "resolved": "agents/community-agent",
      "link": true
    },
    "node_modules/@intellectro/governance": {
      "resolved": "packages/governance",
      "link": true
    },
    "node_modules/@intellectro/provenance": {
      "resolved": "packages/provenance",
      "link": true
    },
    "packages/governance": {
      "name": "@intellectro/governance",
      "version": "0.0.1-alpha"
    },
    "packages/provenance": {
      "name": "@intellectro/provenance",
      "version": "0.0.1-alpha"
    }
  }
}
